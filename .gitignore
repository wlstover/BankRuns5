# Simulation output — task dirs run to ~200 GB on HPC and figures are
# regenerated per-arm by analysis_p6.R. Nothing under outputs/ is tracked;
# figures the chapter compiles against are curated into figures/ deliberately.
outputs/

# Legacy artifacts of the retired sweep.slurm path, still present on HPC.
# The current pipeline writes params to outputs/<tag>/params.txt and sends
# SLURM logs to /scratch/%u/, so neither of these is regenerated.
logs/
/params.txt

